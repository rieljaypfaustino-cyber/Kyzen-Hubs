-- ══════════ PLOT DETECTION (SARILING PLOT!) ══════════
local function FindMyPlot()
    local ok, result = pcall(function()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        local lname = string.lower(Player.Name)
        -- Check 1: owner attribute
        for _, plot in ipairs(plots:GetChildren()) do
            local owner = plot:GetAttribute("Owner") or plot:GetAttribute("OwnerName") or plot:GetAttribute("Player")
            local ownerId = plot:GetAttribute("OwnerId") or plot:GetAttribute("OwnerUserId")
            if (owner and string.lower(tostring(owner)) == lname) or (ownerId == Player.UserId) then
                return plot
            end
        end
        -- Check 2: player name sa sign/billboard sa loob ng plot
        for _, plot in ipairs(plots:GetChildren()) do
            for _, d in ipairs(plot:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextButton")) and string.find(string.lower(d.Text), lname, 1, true) then
                    return plot
                end
            end
        end
        -- Check 3: nearest SpawnPoint sa kinatatayuan ko
        local hrp = GetHRP()
        if hrp then
            local best, bestDist = nil, math.huge
            for _, plot in ipairs(plots:GetChildren()) do
                local sp = plot:FindFirstChild("SpawnPoint", true)
                if sp then
                    local dist = (sp.Position - hrp.Position).Magnitude
                    if dist < bestDist then best, bestDist = plot, dist end
                end
            end
            return best
        end
        return nil
    end)
    return ok and result or nil
end

-- ══════════ EGG DETECTION ══════════
local function GetEggRarity(egg)
    local ok, result = pcall(function()
        for _, attr in ipairs({"Rarity","EggRarity","Tier","EggTier","Quality"}) do
            local v = egg:GetAttribute(attr)
            if v then return tostring(v) end
        end
        for _, d in ipairs(egg:GetDescendants()) do
            if d.GetAttribute then
                for _, attr in ipairs({"Rarity","EggRarity","Tier"}) do
                    local v = d:GetAttribute(attr)
                    if v then return tostring(v) end
                end
            end
        end
        -- name-based fallback
        local n = string.lower(egg.Name)
        for _, r in ipairs(RARITY_PRIORITY) do
            if string.find(n, string.lower(r), 1, true) then return r end
        end
        return nil
    end)
    return ok and result or nil
end

local function GetEggArea(pos)
    local ok, result = pcall(function()
        local ranges = {
            {"Forest", 550, 700}, {"Lake", 700, 770}, {"Desert", 770, 880},
            {"Jungle", 880, 1000}, {"Snow", 1000, 1140}, {"Volcano", 1140, 1300},
            {"Abyss Ocean", 1300, 1480}, {"Prehistoric", 1480, 1680},
            {"Cosmic", 1680, 2000}, {"Cherry Blossom", 2000, 4400},
            {"Titan Temple", 4400, 5200}, {"Light & Dark", 5200, 99999}
        }
        for _, r in ipairs(ranges) do
            if pos.X >= r[2] and pos.X < r[3] then return r[1] end
        end
        return nil
    end)
    return ok and result or nil
end

local function RarityRank(r)
    for i, v in ipairs(RARITY_PRIORITY) do
        if string.lower(v) == string.lower(r or "") then return i end
    end
    return 999
end

local function GetEggPos(egg)
    local ok, result = pcall(function()
        if egg:IsA("BasePart") then return egg.Position end
        if egg:IsA("Model") then return egg:GetPivot().Position end
        if egg:IsA("Attachment") then return egg.WorldPosition end
        return nil
    end)
    return ok and result or nil
end

local function FindTargetEgg()
    local ok, best = pcall(function()
        local candidates = {}
        -- Source 1: Workspace.Eggs
        local eggsFolder = workspace:FindFirstChild("Eggs")
        if eggsFolder then
            for _, egg in ipairs(eggsFolder:GetDescendants()) do
                if egg:IsA("BasePart") or egg:IsA("Model") then
                    table.insert(candidates, egg)
                end
            end
        end
        -- Source 2: AreaEggSlotsClient
        local slots = workspace:FindFirstChild("AreaEggSlotsClient")
        if slots then
            for _, egg in ipairs(slots:GetDescendants()) do
                if egg:IsA("BasePart") or egg:IsA("Model") then
                    table.insert(candidates, egg)
                end
            end
        end
        -- Source 3: Steal prompts sa buong workspace (CarryAreaEgg style!)
        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and string.find(string.lower(prompt.ActionText or ""), "steal") then
                local holder = prompt.Parent
                if holder then
                    table.insert(candidates, holder)
                end
            end
        end

        -- Filter: rarity + area match, pinakamataas na rarity ang panalo
        local bestEgg, bestRank, bestPrompt = nil, 999, nil
        for _, egg in ipairs(candidates) do
            local pos = GetEggPos(egg)
            if pos then
                local rarity = GetEggRarity(egg)
                local area = GetEggArea(pos)
                local rarityOK = (#SelectedRarity == 0) -- kung walang select, any
                if not rarityOK and rarity then
                    for _, r in ipairs(SelectedRarity) do
                        if string.lower(r) == string.lower(rarity) then rarityOK = true break end
                    end
                end
                local areaOK = false
                if area then
                    for _, a in ipairs(SelectedArea) do
                        if a == area then areaOK = true break end
                    end
                end
                if rarityOK and areaOK then
                    local rank = RarityRank(rarity)
                    if rank < bestRank then
                        bestEgg, bestRank = egg, rank
                        -- hanapin ang steal prompt nito
                        bestPrompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                    end
                end
            end
        end
        return bestEgg, bestPrompt
    end)
    if ok then return best end
    return nil, nil
end

