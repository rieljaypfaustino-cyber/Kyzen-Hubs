local function IsCarryingEgg()
    local ok, result = pcall(function()
        local char = Player.Character
        if not char then return false end
        if char:GetAttribute("Carrying") or char:GetAttribute("CarryingEgg") then return true end
        for _, d in ipairs(char:GetChildren()) do
            local n = string.lower(d.Name)
            if string.find(n, "egg", 1, true) and not d:IsA("Shirt") and not d:IsA("Pants") then
                return true
            end
        end
        return false
    end)
    return ok and result or false
end

-- ══════════ STEAL SYSTEM (HELD-IN-HAND FLOW!) ══════════
local function StealEgg(egg, prompt)
    Stealing = true
    pcall(function()
        local pos = GetEggPos(egg)
        if not pos then Stealing = false return end

        -- 1. Teleport sa tabi ng egg
        TP(CFrame.new(pos + Vector3.new(0, 4, 4)))
        task.wait(0.35)

        -- 2. TRY REMOTE MUNA (AskFieldEggCarry)
        local carried = false
        if RF_Carry then
            local eggId = egg:GetAttribute("Id") or egg:GetAttribute("EggId") or egg.Name
            local okRemote = pcall(function()
                RF_Carry:InvokeServer(eggId)
            end)
            if okRemote then
                task.wait(0.5)
                carried = IsCarryingEgg()
            end
        end

        -- 3. FALLBACK: PROMPT STEAL (0s hold — BYPASS ng countdown!)
        if not carried then
            local p = prompt or egg:FindFirstChildWhichIsA("ProximityPrompt", true)
            if not p then
                -- hanapin ang malapit na steal prompt
                for _, pp in ipairs(workspace:GetDescendants()) do
                    if pp:IsA("ProximityPrompt") and string.find(string.lower(pp.ActionText or ""), "steal") then
                        local parentPos = pp.Parent and GetEggPos(pp.Parent)
                        if parentPos and (parentPos - pos).Magnitude < 20 then p = pp break end
                    end
                end
            end
            if p then
                pcall(function()
                    p.HoldDuration = 0 -- BYPASS ng 1.2s countdown!
                    p.RequiresLineOfSight = false
                    p.MaxActivationDistance = math.huge
                end)
                task.wait(0.1)
                if fireproximityprompt then
                    pcall(fireproximityprompt, p)
                else
                    pcall(function()
                        p:InputHoldBegin()
                        task.wait(0.15)
                        p:InputHoldEnd()
                    end)
                end
                task.wait(0.8)
                carried = IsCarryingEgg()
            end
        end

        if not carried then
            Notify("❌ Di na-steal, try ulit!", "error")
            Stealing = false
            return
        end

        Notify("🥚 Egg nakuha! Held sa kamay mo — papunta sa plot mo!", "success")

        -- 4. DALHIN SA SARILING PLOT (held pa rin sa kamay!)
        if not MyPlot then MyPlot = FindMyPlot() end
        if MyPlot then
            local sp = MyPlot:FindFirstChild("SpawnPoint", true)
            local dropPos = sp and sp.Position or MyPlot:GetPivot().Position
            TP(CFrame.new(dropPos + Vector3.new(0, 5, 0)))
            task.wait(0.8)

            -- 5. I-DROP ANG EGG SA PLOT
            local dropped = false
            if RF_Drop then
                pcall(function() RF_Drop:InvokeServer() end)
                task.wait(0.4)
                dropped = not IsCarryingEgg()
            end
            if not dropped then task.wait(1) end
            Notify("📦 Egg na-drop sa plot mo!", "success")
        else
            Notify("⚠️ Plot mo di ma-detect, dala mo pa ang egg!", "warning")
        end

        -- 6. BALIK SA SAFEZONE
        TP(CFrame.new(SAFEZONE))
        Notify("🏠 Balik na sa Safezone!", "info")
    end)
    Stealing = false
end

