-- ═══ PLOT DETECTION ═══
local function FindMyPlot()
    local ok, result = pcall(function()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        local lname = string.lower(Player.Name)
        for _, plot in ipairs(plots:GetChildren()) do
            local owner = plot:GetAttribute("Owner") or plot:GetAttribute("OwnerName") or plot:GetAttribute("Player")
            local ownerId = plot:GetAttribute("OwnerId") or plot:GetAttribute("OwnerUserId")
            if (owner and string.lower(tostring(owner)) == lname) or (ownerId == Player.UserId) then
                return plot
            end
        end
        for _, plot in ipairs(plots:GetChildren()) do
            for _, d in ipairs(plot:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextButton")) and string.find(string.lower(d.Text), lname, 1, true) then
                    return plot
                end
            end
        end
        local hrp = GetHRP()
        if hrp then
            local best, bestDist = nil, math.huge
            for _, plot in ipairs(plots:GetChildren()) do
                local sp = plot:FindFirstChild("SpawnPoint", true)
                if sp then
                    local dist = (sp.Position - hrp.Position).Magnitude
                    if dist < bestDist then best, bestDist = plot, dist end
                end
            end
            return best
        end
        return nil
    end)
    return ok and result or nil
end

-- ═══ EGG DETECTION ═══
local function GetEggRarity(egg)
    local ok, r = pcall(function()
        for _, attr in ipairs({"Rarity","EggRarity","Tier","EggTier","Quality"}) do
            local v = egg:GetAttribute(attr)
            if v then return tostring(v) end
        end
        local n = string.lower(egg.Name)
        for _, rr in ipairs(RARITY_PRIORITY) do
            if string.find(n, string.lower(rr), 1, true) then return rr end
        end
        return nil
    end)
    return ok and r or nil
end

local function GetEggArea(pos)
    local ok, r = pcall(function()
        local ranges = {
            {"Forest",550,700},{"Lake",700,770},{"Desert",770,880},{"Jungle",880,1000},
            {"Snow",1000,1140},{"Volcano",1140,1300},{"Abyss Ocean",1300,1480},
            {"Prehistoric",1480,1680},{"Cosmic",1680,2000},{"Cherry Blossom",2000,4400},
            {"Titan Temple",4400,5200},{"Light & Dark",5200,99999}
        }
        for _, rr in ipairs(ranges) do
            if pos.X >= rr[2] and pos.X < rr[3] then return rr[1] end
        end
        return nil
    end)
    return ok and r or nil
end

local function RarityRank(r)
    for i, v in ipairs(RARITY_PRIORITY) do
        if string.lower(v) == string.lower(r or "") then return i end
    end
    return 999
end

local function GetEggPos(e)
    local ok, r = pcall(function()
        if e:IsA("BasePart") then return e.Position end
        if e:IsA("Model") then return e:GetPivot().Position end
        if e:IsA("Attachment") then return e.WorldPosition end
        return nil
    end)
    return ok and r or nil
end

local function FindTargetEgg()
    local ok, egg, prompt = pcall(function()
        local candidates = {}
        local eggsFolder = workspace:FindFirstChild("Eggs")
        if eggsFolder then
            for _, e in ipairs(eggsFolder:GetDescendants()) do
                if e:IsA("BasePart") or e:IsA("Model") then table.insert(candidates, e) end
            end
        end
        local slots = workspace:FindFirstChild("AreaEggSlotsClient")
        if slots then
            for _, e in ipairs(slots:GetDescendants()) do
                if e:IsA("BasePart") or e:IsA("Model") then table.insert(candidates, e) end
            end
        end
        for _, pp in ipairs(workspace:GetDescendants()) do
            if pp:IsA("ProximityPrompt") and string.find(string.lower(pp.ActionText or ""), "steal") then
                if pp.Parent then table.insert(candidates, pp.Parent) end
            end
        end
        local bestEgg, bestRank, bestPrompt = nil, 999, nil
        for _, e in ipairs(candidates) do
            local pos = GetEggPos(e)
            if pos then
                local rarity = GetEggRarity(e)
                local area = GetEggArea(pos)
                local rarityOK = (#SelectedRarity == 0)
                if not rarityOK and rarity then
                    for _, r in ipairs(SelectedRarity) do
                        if string.lower(r) == string.lower(rarity) then rarityOK = true break end
                    end
                end
                local areaOK = false
                if area then
                    for _, a in ipairs(SelectedArea) do
                        if a == area then areaOK = true break end
                    end
                end
                if rarityOK and areaOK then
                    local rank = RarityRank(rarity)
                    if rank < bestRank then
                        bestEgg, bestRank = e, rank
                        bestPrompt = e:FindFirstChildWhichIsA("ProximityPrompt", true)
                    end
                end
            end
        end
        return bestEgg, bestPrompt
    end)
    if ok then return egg, prompt end
    return nil, nil
end

