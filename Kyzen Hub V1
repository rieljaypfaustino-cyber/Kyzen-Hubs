-- ══════════ PLOT DETECTION (SARILING PLOT LANG!) ══════════
local MyPlot = nil
local function FindMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local lname = string.lower(Player.Name)
    for _, plot in ipairs(plots:GetChildren()) do
        -- Check 1: owner attribute
        local owner = plot:GetAttribute("Owner") or plot:GetAttribute("OwnerName") or plot:GetAttribute("Player")
        local ownerId = plot:GetAttribute("OwnerId") or plot:GetAttribute("OwnerUserId")
        if (owner and string.lower(tostring(owner)) == lname)
        or (ownerId == Player.UserId) then
            return plot
        end
        -- Check 2: may name na player sa loob (sign/billboard)
        for _, d in ipairs(plot:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and string.find(string.lower(d.Text), lname, 1, true) then
                return plot
            end
        end
    end
    -- Check 3: malapit sa spawn point ko
    local _, hrp = GetCharacter()
    local best, bestDist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local sp = plot:FindFirstChild("SpawnPoint", true)
        if sp then
            local dist = (sp.Position - hrp.Position).Magnitude
            if dist < bestDist then best, bestDist = plot, dist end
        end
    end
    return best
end

-- ══════════ EGG DETECTION (TOTOONG STRUCTURE) ══════════
local function GetEggRarity(egg)
    for _, attr in ipairs({"Rarity","EggRarity","Tier","EggTier","Quality"}) do
        local v = egg:GetAttribute(attr)
        if v then return tostring(v) end
    end
    -- check sa loob ng model
    for _, d in ipairs(egg:GetDescendants()) do
        for _, attr in ipairs({"Rarity","EggRarity","Tier"}) do
            local v = d:GetAttribute and d:GetAttribute(attr)
            if v then return tostring(v) end
        end
    end
    return nil
end

local function GetEggArea(pos)
    -- gamit ang X-coordinate ranges mula sa GuardAreas dump
    local ranges = {
        {"Forest", 550, 700}, {"Lake", 700, 770}, {"Desert", 770, 880},
        {"Jungle", 880, 1000}, {"Snow", 1000, 1140}, {"Volcano", 1140, 1300},
        {"Abyss Ocean", 1300, 1480}, {"Prehistoric", 1480, 1680},
        {"Cosmic", 1680, 2000}, {"Cherry Blossom", 2000, 4400},
        {"Titan Temple", 4400, 5200}, {"Light & Dark", 5200, 99999}
    }
    for _, r in ipairs(ranges) do
        if pos.X >= r[2] and pos.X < r[3] then return r[1] end
    end
    return nil
end

local function RarityRank(r)
    for i, v in ipairs(RARITY_PRIORITY) do
        if string.lower(v) == string.lower(r or "") then return i end
    end
    return 999
end

local function FindTargetEgg()
    local targets = {}
    -- Source 1: Workspace.Eggs
    local eggsFolder = workspace:FindFirstChild("Eggs")
    if eggsFolder then
        for _, egg in ipairs(eggsFolder:GetChildren()) do
            table.insert(targets, egg)
        end
    end
    -- Source 2: AreaEggSlotsClient
    local slots = workspace:FindFirstChild("AreaEggSlotsClient")
    if slots then
        for _, s in ipairs(slots:GetDescendants()) do
            if s:IsA("Model") or s:IsA("BasePart") then
                local parent = s.Parent
                if parent and parent ~= slots then table.insert(targets, s) end
            end
        end
    end
    -- Filter: rarity + area match, priority sort
    local best, bestRank = nil, 999
    for _, egg in ipairs(targets) do
        local pos = egg:IsA("BasePart") and egg.Position or (egg:IsA("Model") and egg:GetPivot().Position)
        if pos then
            local rarity = GetEggRarity(egg)
            local area = GetEggArea(pos)
            local rarityOK, areaOK = false, false
            for _, r in ipairs(SelectedRarity) do
                if rarity and string.lower(r) == string.lower(rarity) then rarityOK = true break end
                if not rarity then rarityOK = true break end -- kung walang rarity attr, try pa rin
            end
            for _, a in ipairs(SelectedArea) do
                if area and a == area then areaOK = true break end
            end
            if rarityOK and areaOK then
                local rank = RarityRank(rarity)
                if rank < bestRank then best, bestRank = egg, rank end
            end
        end
    end
    return best
end

-- ══════════ STEAL SYSTEM (HELD IN HAND FLOW!) ══════════
local function IsCarryingEgg()
    local char = Player.Character
    if not char then return false end
    -- may bitbit na egg model sa character
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("Model") or (d:IsA("BasePart") and not d:IsA("MeshPart") and string.find(string.lower(d.Name), "egg")) then
            if string.find(string.lower(d.Name), "egg") then return true end
        end
    end
    -- o attribute sa character
    if char:GetAttribute("Carrying") or char:GetAttribute("CarryingEgg") then return true end
    return false
end

local function StealEgg(egg)
    Stealing = true
    local ok, err = pcall(function()
        local pos = egg:IsA("BasePart") and egg.Position or egg:GetPivot().Position
        -- 1. Teleport sa tabi ng egg (HINDI sakto sa taas para di mamatay)
        TP(CFrame.new(pos + Vector3.new(0, 4, 4)))
        task.wait(0.3)

        -- 2. TRY REMOTE FIRST (AskFieldEggCarry)
        local carried = false
        if RF_Carry then
            local eggId = egg:GetAttribute("Id") or egg:GetAttribute("EggId") or egg.Name
            local rOK, rErr = pcall(function()
                RF_Carry:InvokeServer(eggId)
            end)
            if rOK then
                task.wait(0.5)
                carried = IsCarryingEgg()
            end
        end

        -- 3. FALLBACK: PROMPT STEAL (0s hold bypass!)
        if not carried then
            local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
            if not prompt then
                -- hanapin ang CarryAreaEgg sa malapit
                local promptPart = workspace:FindFirstChild("SmartPromptPart")
                if promptPart then
                    for _, pp in ipairs(promptPart:GetChildren()) do
                        local p = pp:FindFirstChildWhichIsA("ProximityPrompt")
                        if p and pp:IsA("BasePart") and (pp.Position - pos).Magnitude < 15 then
                            prompt = p
                            break
                        end
                    end
                end
            end
            if prompt then
                prompt.HoldDuration = 0 -- BYPASS ng 1.2s countdown!
                prompt.RequiresLineOfSight = false
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                else
                    -- manual hold fallback
                    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.2)
                    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end
                task.wait(0.8)
                carried = IsCarryingEgg()
            end
        end

        if not carried then
            Notify("❌ Di na-steal ang egg, try ulit!", "error")
            Stealing = false
            return
        end

        Notify("🥚 Egg nakuha! Bitbit mo na — papunta sa plot mo!", "success")

        -- 4. DALHIN SA SARILING PLOT (hindi inventory — held in hand!)
        if not MyPlot then MyPlot = FindMyPlot() end
        if MyPlot then
            local sp = MyPlot:FindFirstChild("SpawnPoint", true)
            local dropPos = sp and sp.Position or MyPlot:GetPivot().Position
            TP(CFrame.new(dropPos + Vector3.new(0, 5, 0)))
            task.wait(0.8)

            -- 5. I-DROP ANG EGG SA PLOT (AskFieldEggDrop remote)
            local dropped = false
            if RF_Drop then
                pcall(function() RF_Drop:InvokeServer() end)
                task.wait(0.3)
                dropped = not IsCarryingEgg()
            end
            if not dropped then
                -- fallback: i-proceed pa rin (baka auto-drop na sa plot)
                task.wait(1)
            end
            Notify("📦 Egg na-drop sa plot mo!", "success")
        end

        -- 6. BALIK SA SAFEZONE
        TP(CFrame.new(SAFEZONE))
        task.wait(0.3)
        Notify("🏠 Balik na sa Safezone!", "info")
    end)
    if not ok then Notify("⚠️ Error: " .. tostring(err), "error") end
    Stealing = false
end

