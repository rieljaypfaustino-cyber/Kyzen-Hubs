    local function MakeMultiSelect(order, titleText, items, selectedTable, isRarity)
        local section = Instance.new("Frame")
        section.Size = UDim2.new(1, 0, 0, 30 + math.ceil(#items / 2) * 36 + 8)
        section.BackgroundColor3 = Color3.fromRGB(24, 24, 36)
        section.LayoutOrder = order
        section.Parent = configPage
        Instance.new("UICorner", section).CornerRadius = UDim.new(0, 12)

        local st = Instance.new("TextLabel")
        st.Size = UDim2.new(1, -16, 0, 26)
        st.Position = UDim2.new(0, 12, 0, 4)
        st.BackgroundTransparency = 1
        st.Text = titleText
        st.TextColor3 = Color3.fromRGB(0, 255, 150)
        st.TextSize = 13
        st.Font = Enum.Font.GothamBold
        st.TextXAlignment = Enum.TextXAlignment.Left
        st.Parent = section

        local grid = Instance.new("Frame")
        grid.Size = UDim2.new(1, -16, 1, -32)
        grid.Position = UDim2.new(0, 8, 0, 30)
        grid.BackgroundTransparency = 1
        grid.Parent = section

        local g = Instance.new("UIGridLayout")
        g.CellSize = UDim2.new(0.5, -4, 0, 30)
        g.CellPadding = UDim2.new(0, 6, 0, 6)
        g.Parent = grid

        for _, item in ipairs(items) do
            local b = Instance.new("TextButton")
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            b.Text = item
            b.TextColor3 = Color3.fromRGB(180, 180, 200)
            b.TextSize = 11
            b.Font = Enum.Font.GothamBold
            b.Parent = grid
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
            if isRarity and RARITY_COLORS[item] then
                b.TextColor3 = RARITY_COLORS[item]
            end

            b.MouseButton1Click:Connect(function()
                local idx = table.find(selectedTable, item)
                if idx then
                    table.remove(selectedTable, idx)
                    b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                    b.TextColor3 = isRarity and RARITY_COLORS[item] or Color3.fromRGB(180, 180, 200)
                else
                    table.insert(selectedTable, item)
                    b.BackgroundColor3 = Color3.fromRGB(0, 200, 110)
                    b.TextColor3 = Color3.new(0, 0, 0)
                end
            end)
        end
    end

    MakeMultiSelect(1, "🥚 Rarity Egg (Divine unahin!)", RARITY_PRIORITY, SelectedRarity, true)
    MakeMultiSelect(2, "🌍 Area/Place (Totoong coordinates!)", AREAS, SelectedArea, false)

