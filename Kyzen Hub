        b.BackgroundColor3 = Config.Area[area] and Color3.fromRGB(0,200,110) or Color3.fromRGB(40,40,55)
        b.Text = area
        b.TextColor3 = Config.Area[area] and Color3.new(0,0,0) or Color3.fromRGB(200,200,210)
        b.TextSize = 11
        b.Font = Enum.Font.Gotham
        b.Parent = areaScroll
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        b.MouseButton1Click:Connect(function()
            Config.Area[area] = not Config.Area[area]
            if Config.Area[area] then
                table.insert(SelectedArea, area)
                b.BackgroundColor3 = Color3.fromRGB(0,200,110)
                b.TextColor3 = Color3.new(0,0,0)
            else
                for i, v in ipairs(SelectedArea) do
                    if v == area then table.remove(SelectedArea, i) break end
                end
                b.BackgroundColor3 = Color3.fromRGB(40,40,55)
                b.TextColor3 = Color3.fromRGB(200,200,210)
            end
        end)
    end

    -- Notification
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 300, 0, 50)
    notif.Position = UDim2.new(1, 320, 0, 20)
    notif.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    notif.Parent = gui
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 12)
    local ns = Instance.new("UIStroke")
    ns.Color = Color3.fromRGB(0, 255, 150)
    ns.Thickness = 1.5
    ns.Parent = notif
    local nmsg = Instance.new("TextLabel")
    nmsg.Name = "Message"
    nmsg.Size = UDim2.new(1, -16, 1, 0)
    nmsg.Position = UDim2.new(0, 8, 0, 0)
    nmsg.BackgroundTransparency = 1
    nmsg.TextColor3 = Color3.new(1,1,1)
    nmsg.TextSize = 13
    nmsg.Font = Enum.Font.Gotham
    nmsg.TextWrapped = true
    nmsg.Parent = notif
    GUI.Notification = notif

    -- Tabs switching
    local function SwitchTab(tab)
        local c = tab == "Cheats"
        cheatsTab.BackgroundColor3 = c and Color3.fromRGB(0,200,110) or Color3.fromRGB(45,45,60)
        cheatsTab.TextColor3 = c and Color3.new(0,0,0) or Color3.new(1,1,1)
        configTab.BackgroundColor3 = not c and Color3.fromRGB(0,200,110) or Color3.fromRGB(45,45,60)
        configTab.TextColor3 = not c and Color3.new(0,0,0) or Color3.new(1,1,1)
        cheatsPage.Visible = c
        configPage.Visible = not c
    end
    cheatsTab.MouseButton1Click:Connect(function() SwitchTab("Cheats") end)
    configTab.MouseButton1Click:Connect(function() SwitchTab("Config") end)

    -- Toggles
    stealBtn.MouseButton1Click:Connect(function()
        AutoSteal.Enabled = not AutoSteal.Enabled
        if AutoSteal.Enabled then
            if #SelectedRarity == 0 or #SelectedArea == 0 then
                AutoSteal.Enabled = false
                Notify("⚠️ Pili muna ng Rarity at Area sa Config!", "error")
                SwitchTab("Config")
                return
            end
            AutoStealLoop()
            Notify("🥚 Auto Steal Egg: ON!", "success")
        else
            Notify("🥚 Auto Steal Egg: OFF", "warning")
        end
        local on = AutoSteal.Enabled
        stealBg.BackgroundColor3 = on and Color3.fromRGB(0,200,110) or Color3.fromRGB(60,60,75)
        stealKnob.Position = on and UDim2.new(1,-23,0.5,-10) or UDim2.new(0,3,0.5,-10)
        stealKnob.BackgroundColor3 = on and Color3.fromRGB(0,255,150) or Color3.fromRGB(255,100,100)
    end)

    tmBtn.MouseButton1Click:Connect(function()
        AutoTreadmill.Enabled = not AutoTreadmill.Enabled
        if AutoTreadmill.Enabled then
            AutoTreadmillLoop()
            Notify("🏃 Auto Treadmill: ON!", "success")
        else
            Notify("🏃 Auto Treadmill: OFF", "warning")
        end
        local on = AutoTreadmill.Enabled
        tmBg.BackgroundColor3 = on and Color3.fromRGB(0,200,110) or Color3.fromRGB(60,60,75)
        tmKnob.Position = on and UDim2.new(1,-23,0.5,-10) or UDim2.new(0,3,0.5,-10)
        tmKnob.BackgroundColor3 = on and Color3.fromRGB(0,255,150) or Color3.fromRGB(255,100,100)
    end)

    -- Open/close
    btn.MouseButton1Click:Connect(function()
        IsGUIOpen = not IsGUIOpen
        if IsGUIOpen then
            TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Position = UDim2.new(0, 85, 0, 120)}):Play()
        else
            TweenService:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {Position = UDim2.new(0, -440, 0, 120)}):Play()
        end
    end)
    close.MouseButton1Click:Connect(function()
        IsGUIOpen = false
        TweenService:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Position = UDim2.new(0, -440, 0, 120)}):Play()
    end)

    Notify("⚡ Kyzen Hub v4 Loaded! (Decoded!)", "success")
end

