local function Notify(msg, msgType)
    local colors = {success=Color3.fromRGB(0,255,100), warning=Color3.fromRGB(255,200,0), error=Color3.fromRGB(255,100,100)}
    local notif = GUI.Notification
    if not notif then return end
    local label = notif:FindFirstChild("Message")
    if not label then return end
    label.Text = msg
    label.TextColor3 = colors[msgType] or Color3.new(1,1,1)
    notif.BackgroundTransparency = 0
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(1, -320, 0, 20)}):Play()
    task.delay(2.5, function()
        TweenService:Create(notif, TweenInfo.new(0.3),
            {Position = UDim2.new(1, 320, 0, 20), BackgroundTransparency = 1}):Play()
    end)
end

local function MakeDraggable(handle, target)
    local dragging, ds, sp = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, ds, sp = true, i.Position, target.Position
        end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    handle.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            target.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)
end

-- Aling area ang pinakamalapit sa posisyon na ito? (gamit ang totoong coordinates!)
local function GetAreaFromPosition(pos)
    local best, bestDist = nil, math.huge
    for area, areaPos in pairs(AREA_POSITIONS) do
        -- X-axis lang ang tinitingnan kasi naka-line ang mga area sa X
        local dist = math.abs(pos.X - areaPos.X)
        if dist < bestDist then best, bestDist = area, dist end
    end
    -- Tolerance: 600 studs bawat area gap
    if bestDist < 800 then return best end
    return nil
end

-- Anong rarity ang egg? (attributes → name → ancestors)
local function GetRarity(obj)
    local cur = obj
    local depth = 0
    while cur and cur ~= workspace and depth < 6 do
        -- 1. Attributes
        local a = cur:GetAttributes()
        for _, key in ipairs({"Rarity", "EggRarity", "RarityType", "Tier"}) do
            if a[key] and typeof(a[key]) == "string" then
                for _, r in ipairs(RARITY_PRIORITY) do
                    if a[key]:lower():find(r:lower()) then return r end
                end
            end
        end
        -- 2. Name
        local n = cur.Name:lower()
        for _, r in ipairs(RARITY_PRIORITY) do
            if n:find(r:lower()) then return r end
        end
        cur = cur.Parent
        depth = depth + 1
    end
    return nil
end

-- ══════════ EGG DETECTION (totoong structure!) ══════════
-- Ang mga egg ay nasa Workspace.Eggs (server) at AreaEggSlotsClient (client render)
-- May CarryAreaEgg prompt na "Action=Steal Object=Egg" — ito ang target natin!
local function FindTargetEggs()
    local results = {}
    local seen = {}

    -- Scan ang mga prompt na "Steal" (SmartPromptPart.CarryAreaEgg style)
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.ActionText == "Steal" then
            local holder = prompt.Parent
            if holder and not seen[holder] then
                seen[holder] = true
                -- Position ng egg (ang prompt parent o ang attachment nito)
                local pos
                if holder:IsA("Attachment") then
                    pos = holder.WorldPosition
                elseif holder:IsA("BasePart") then
                    pos = holder.Position
                elseif holder:IsA("Model") then
                    pos = holder:GetPivot().Position
                end

                if pos then
                    local rarity = GetRarity(holder)
                    local area = GetAreaFromPosition(pos)

                    -- ✅ CONFIG CHECK: rarity AT area dapat naka-select
                    if rarity and area and Config.Rarity[rarity] and Config.Area[area] then
                        table.insert(results, {
                            Prompt = prompt, Holder = holder,
                            Rarity = rarity, Area = area, Position = pos
                        })
                    end
                end
            end
        end
    end

    -- Sort: mataas na rarity muna
    table.sort(results, function(a, b)
        local ai, bi = 99, 99
        for i, r in ipairs(RARITY_PRIORITY) do
            if a.Rarity == r then ai = i end
            if b.Rarity == r then bi = i end
        end
        return ai < bi
    end)
    return results
end

-- ══════════ STEAL MECHANICS (totoong system!) ══════════
local function SafeTeleport(pos)
    local char = Player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
end

-- BYPASS ANG 1.2s HOLD! 🔓
local function StealPrompt(prompt)
    local ok = pcall(function()
        prompt.HoldDuration = 0 -- client-side bypass ng countdown
        prompt.MaxActivationDistance = math.huge
        prompt.RequiresLineOfSight = false
    end)
    -- fireproximityprompt = pinaka-maaasahang bypass sa mga executor
    if fireproximityprompt then
        pcall(function() fireproximityprompt(prompt, 0) end)
        return true
    end
    -- Fallback: hold begin/end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait()
        prompt:InputHoldEnd()
    end)
    return ok
end

-- May hawak na ba tayong egg? (carry check)
local function IsCarryingEgg()
    local char = Player.Character
    if not char then return false end
    for _, child in ipairs(char:GetChildren()) do
        local n = child.Name:lower()
        if child:IsA("Tool") or n:find("egg") or n:find("carry") or n:find("held") then
            return true
        end
    end
    -- Check ang prompt events din: kung may "FieldEggCarry" state
    return false
end

-- ══════════ 🥚 AUTO STEAL LOOP (totoong flow!) ══════════
-- FLOW: hintayin may egg spawn → teleport sa egg → bypass steal prompt
--       → kapag nakahawak na → teleport sa safezone → egg sa inventory!
local function AutoStealLoop()
    task.spawn(function()
        while AutoSteal.Enabled do
            local char = Player.Character
            if not char then task.wait(0.5) continue end

            if IsCarryingEgg() then
                -- ✅ MAY HAWAK NA! Balik sa safezone (totoong coordinate!)
                SafeTeleport(SAFEZONE)
                Notify("✅ Nakaw na ang egg! Balik sa safezone...", "success")
                task.wait(1.5)
            else
                local eggs = FindTargetEggs()
                if #eggs == 0 then
                    task.wait(0.5) -- walang match — maghintay ng spawn (FieldEggBatchShifted!)
                else
                    local target = eggs[1] -- pinakamataas na rarity (Divine muna!)
                    -- Teleport sa egg (bago pa makita ng bantay!)
                    SafeTeleport(target.Position)
                    task.wait(0.15)
                    if target.Prompt.Parent then
                        StealPrompt(target.Prompt)
                    end
                    task.wait(0.4)
                end
            end
        end
    end)
end

-- ══════════ 🏃 AUTO TREADMILL LOOP (totoong structure!) ══════════
-- Ang mga treadmill ay nasa Plots.N.TreadmillBottom — hanapin ang plot mo!
local function FindMyTreadmill()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    -- Hanapin ang plot na may SpawnPoint na pinakamalapit sa ating spawn
    local best, bestDist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local tm = plot:FindFirstChild("TreadmillBottom")
        if tm then
            local dist = (tm.Position - SAFEZONE).Magnitude
            if dist < bestDist then best, bestDist = tm, dist end
        end
    end
    return best
end

local function AutoTreadmillLoop()
    task.spawn(function()
        while AutoTreadmill.Enabled do
            local eggs = FindTargetEggs()
            if #eggs > 0 and AutoSteal.Enabled then
                task.wait(0.5) -- may target! priority ang auto steal
            else
                local tm = FindMyTreadmill()
                if tm then
                    SafeTeleport(tm.Position)
                    local char = Player.Character
                    local hum = char and char:FindFirstChild("Humanoid")
                    if hum then hum.WalkSpeed = 100 end
                    task.wait(0.5)
                else
                    task.wait(1)
                end
            end
        end
    end)
end

